# =============================================================================
# Kung Fu Chess -- local environment configuration
# =============================================================================
# `docker compose` loads a file named exactly `.env`, in the same
# directory as docker-compose.yml, automatically -- no --env-file flag
# needed. Every ${VAR} in docker-compose.yml is substituted from here at
# `docker compose` PARSE time (before any container starts), so a change
# here requires `docker compose up` (recreating containers), not just a
# restart.
#
# These are local-dev defaults / placeholder secrets only. Do not reuse
# POSTGRES_PASSWORD anywhere real. This file is gitignored -- if you
# want the variable list itself tracked, commit a `.env.example` copy
# with the secrets blanked out instead.
# =============================================================================

# ---- PostgreSQL --------------------------------------------------------
POSTGRES_USER=kungfu
POSTGRES_PASSWORD=kungfu_dev_password
POSTGRES_DB=kungfu_chess
POSTGRES_PORT=5432

# ---- Redis --------------------------------------------------------------
# REDIS_PORT is the actual port redis-server listens on inside the
# container (docker-compose.yml passes it to `redis-server --port`) --
# every service's REDIS_HOST/REDIS_PORT env vars read this same value,
# so it never drifts out of sync.
REDIS_PORT=6379
# Host-published port, kept DIFFERENT from REDIS_PORT by default --
# shifted off the 6379 default in case another project's Redis is
# already bound to it on your machine. Internal service-to-service
# traffic always uses REDIS_PORT above and is unaffected by this one.
REDIS_HOST_PORT=6380

# ---- Kafka (KRaft mode, no ZooKeeper) -----------------------------------
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
# Host-published port, shifted off the 9092 default for the same reason
# as REDIS_HOST_PORT above.
KAFKA_HOST_PORT=9094
GAME_ENDED_TOPIC=game_ended
KAFKA_CONSUMER_GROUP=event-consumer

# ---- Gateway (services/gateway) -----------------------------------------
GATEWAY_PORT=8000
SESSION_TTL_S=3600

# ---- Matchmaking (services/matchmaking) ----------------------------------
MATCHMAKING_PORT=8010

# ---- Allocator (services/allocator) --------------------------------------
ALLOCATOR_PORT=8020
# Production value is 5,000 (Server_Design.md decision 7); kept small
# here so the "server is full, try another" retry path is exercisable
# by hand against two local Game Server replicas.
MAX_ROOMS_PER_CONTAINER=100

# ---- Game Servers (services/game_server) ---------------------------------
# Two local replicas of the SAME image -- see docker-compose.yml.
GAME_SERVER_1_PORT=8001
GAME_SERVER_2_PORT=8002

# ---- Event Consumer (services/event_consumer) ----------------------------
EVENT_CONSUMER_PORT=8030
